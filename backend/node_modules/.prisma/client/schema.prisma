generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  STUDENT
}

enum ClubMemberRole {
  LEAD
  CO_LEAD
  MEMBER
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL
}

enum NotificationType {
  REGISTRATION
  REMINDER
  EVENT_UPDATE
  WAITLIST
  CERTIFICATE
  APPROVAL
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(STUDENT)
  department   String?
  rollNumber   String?  @unique
  avatar       String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  ledClubs           Club[]         @relation("ClubLead")
  clubMemberships    ClubMember[]
  createdEvents      Event[]        @relation("EventCreator")
  registrations      Registration[]
  attendances        Attendance[]   @relation("StudentAttendance")
  markedAttendances  Attendance[]   @relation("AttendanceMarker")
  certificates       Certificate[]  @relation("UserCertificates")
  issuedCertificates Certificate[]  @relation("CertificateIssuer")
  notifications      Notification[]

  @@index([email])
  @@index([role])
}

model Club {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String
  category    String
  logo        String?
  banner      String?
  leadId      String?
  lead        User?    @relation("ClubLead", fields: [leadId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ClubMember[]
  events  Event[]

  @@index([slug])
  @@index([category])
}

model ClubMember {
  id       String         @id @default(uuid())
  clubId   String
  club     Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ClubMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model Event {
  id                   String      @id @default(uuid())
  clubId               String
  club                 Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title                String
  slug                 String      @unique
  description          String
  category             String
  venue                String
  startDateTime        DateTime
  endDateTime          DateTime
  capacity             Int
  registrationDeadline DateTime
  bannerUrl            String?
  status               EventStatus @default(DRAFT)
  rejectionReason      String?
  createdById          String
  createdBy            User        @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  registrations Registration[]
  attendances   Attendance[]
  certificates  Certificate[]

  @@index([clubId])
  @@index([status])
  @@index([startDateTime])
  @@index([category])
}

model Registration {
  id               String             @id @default(uuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           RegistrationStatus @default(CONFIRMED)
  qrToken          String             @unique
  waitlistPosition Int?
  registeredAt     DateTime           @default(now())
  cancelledAt      DateTime?

  attendance Attendance?

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@index([qrToken])
}

model Attendance {
  id             String           @id @default(uuid())
  registrationId String           @unique
  registration   Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("StudentAttendance", fields: [userId], references: [id], onDelete: Cascade)
  markedAt       DateTime         @default(now())
  markedById     String
  markedBy       User             @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)
  method         AttendanceMethod @default(QR_SCAN)

  @@index([eventId])
  @@index([userId])
}

model Certificate {
  id                String   @id @default(uuid())
  certificateCode   String   @unique
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  issueDate         DateTime @default(now())
  pdfUrl            String?
  verificationQrUrl String?
  issuedById        String
  issuedBy          User     @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([certificateCode])
  @@index([eventId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}
